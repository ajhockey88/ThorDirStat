<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thordirstat"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="33" />

    <!-- "All files access": needed to measure every folder on internal storage and SD cards. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Lets Shizuku offer ThorDirStat its shell helper, used for Android/data and Android/obb. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for Settings > Check for updates: reads ThorDirStat's GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- So "Open Shizuku" can find Shizuku's app. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- Opens the lists on the bottom screen and the treemap on the top screen. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.thordirstat.main"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Its own task, so it can stay on the other screen next to the lists. -->
        <activity
            android:name=".TreemapActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.thordirstat.treemap"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:taskAffinity="com.thordirstat.main"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <provider
            android:name=".ShizukuBinderProvider"
            android:authorities="com.thordirstat.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Open and Share: hands one file at a time to the app you pick, read-only. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.thordirstat.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
